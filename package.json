{
	"name": "checkbox-style-menu",
	"version": "1.3.0",
	"description": "Provides an intuitive menu for quickly changing checkbox styles in Obsidian (https://obsidian.md)",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian",
		"plugin",
		"checkbox",
		"task",
		"markdown",
		"styles",
		"menu"
	],
	"author": "ReticentEclectic",
	"license": "0BSD",
	"devDependencies": {
		"@eslint/js": "latest",
		"@types/node": "^16.11.6",
		"builtin-modules": "3.3.0",
		"esbuild": "^0.25.3",
		"eslint": "latest",
		"globals": "latest",
		"obsidian": "latest",
		"tslib": "2.4.0",
		"typescript": "^6.0.0",
		"typescript-eslint": "latest"
	},
	"dependencies": {
		"@codemirror/language": "^6.11.0",
		"@popperjs/core": "^2.11.8"
	}
}
